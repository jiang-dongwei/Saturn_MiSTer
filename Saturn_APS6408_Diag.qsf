# Separate standalone revision for the APS6408L DDR OPI diagnostic board.
set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.0 Lite Edition"
set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files_aps6408_diag
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name OPTIMIZATION_MODE "AGGRESSIVE PERFORMANCE"

set_global_assignment -name VERILOG_MACRO "MISTER_PSRAM=1"
set_global_assignment -name VERILOG_MACRO "MISTER_OPI_DIAG=1"
set_global_assignment -name VERILOG_MACRO "MISTER_PSRAM_DIAG=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DOWNSCALE_NN=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"

# Must precede sys.tcl, which suppresses the old functions on shared pins.
source sys/sys_psram_opi.tcl
source sys/sys.tcl
source sys/sys_analog.tcl
source files_aps6408_diag.qip

set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to PSRAM_CLK
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to PSRAM_CE_N
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to PSRAM_DQ[*]
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to PSRAM_DQ[*]
set_instance_assignment -name FAST_OUTPUT_ENABLE_REGISTER ON -to PSRAM_DQS
set_instance_assignment -name FAST_INPUT_REGISTER ON -to PSRAM_DQ[*]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to PSRAM_DQS

set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
